<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivitateDate">

    <TextView
        android:id="@+id/Buliga_Razvan_Info"
        android:layout_width="411dp"
        android:layout_height="43dp"
        android:text="@string/adauga_un_tip_nou_de_telefon"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.116" />

    <Spinner
        android:id="@+id/Buliga_Razvan_spinnerMemorie"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.145" />

    <RadioButton
        android:id="@+id/Buliga_Razvan_radioButton"
        android:layout_width="134dp"
        android:layout_height="46dp"
        android:text="@string/integrare_ai"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.007"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.223" />

    <EditText
        android:id="@+id/BR_editTextText"
        android:layout_width="367dp"
        android:layout_height="49dp"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.009"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/buttonIntoarcere"
        android:layout_width="385dp"
        android:layout_height="40dp"
        android:text="@string/intoarcere_la_activitatea_principala"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.384"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.792" />

    <RatingBar
        android:id="@+id/RB_ratingBar"
        android:layout_width="238dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.906"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.221" />

    <EditText
        android:id="@+id/RB_editTextNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:text="@string/introduID"
        app:layout_constraintBottom_toTopOf="@+id/buttonIntoarcere"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.009"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_Info"
        app:layout_constraintVertical_bias="0.456" />


</androidx.constraintlayout.widget.ConstraintLayout>