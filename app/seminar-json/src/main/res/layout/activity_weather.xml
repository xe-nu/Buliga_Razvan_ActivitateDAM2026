<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WeatherActivity">

    <EditText
        android:id="@+id/etCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/city"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.125" />

    <Spinner
        android:id="@+id/spinnerZile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/etCity"
        app:layout_constraintStart_toStartOf="@id/etCity"
        app:layout_constraintTop_toBottomOf="@id/etCity" />

    <Button
        android:id="@+id/btnCauta"
        android:layout_width="212dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/cauta"
        app:layout_constraintEnd_toEndOf="@id/etCity"
        app:layout_constraintStart_toStartOf="@id/etCity"
        app:layout_constraintTop_toBottomOf="@id/spinnerZile" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCauta" />
</androidx.constraintlayout.widget.ConstraintLayout>