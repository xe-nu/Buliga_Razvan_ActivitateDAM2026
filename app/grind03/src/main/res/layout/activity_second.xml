<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondActivity">

    <TextView
        android:id="@+id/Buliga_Razvan_tvPrel"
        android:layout_width="182dp"
        android:layout_height="49dp"
        android:text="@string/adaugati_o_cutie_noua"
        android:textAlignment="center"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.09" />

    <EditText
        android:id="@+id/Buliga_Razvan_etCod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/cod_cutie"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintStart_toStartOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintTop_toBottomOf="@id/Buliga_Razvan_tvPrel"
        app:layout_constraintVertical_bias="0.041" />

    <EditText
        android:id="@+id/Buliga_Razvan_etCuloare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="@string/culoare"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintVertical_bias="0.162" />

    <Switch
        android:id="@+id/Buliga_Razvan_Fragil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fragil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Buliga_Razvan_Volum"
        app:layout_constraintStart_toStartOf="@+id/Buliga_Razvan_Volum"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintVertical_bias="0.385" />

    <RatingBar
        android:id="@+id/Buliga_Razvan_Rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Buliga_Razvan_Fragil"
        app:layout_constraintStart_toStartOf="@+id/Buliga_Razvan_Fragil"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_tvPrel" />

    <Button
        android:id="@+id/Buliga_Razvan_btnSalvare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salveaza_cutia"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Buliga_Razvan_Rating"
        app:layout_constraintStart_toStartOf="@+id/Buliga_Razvan_Rating"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintVertical_bias="0.636" />

    <Spinner
        android:id="@+id/Buliga_Razvan_Volum"
        android:layout_width="266dp"
        android:layout_height="61dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Buliga_Razvan_etCuloare"
        app:layout_constraintStart_toStartOf="@+id/Buliga_Razvan_etCuloare"
        app:layout_constraintTop_toBottomOf="@+id/Buliga_Razvan_tvPrel"
        app:layout_constraintVertical_bias="0.267" />

</androidx.constraintlayout.widget.ConstraintLayout>